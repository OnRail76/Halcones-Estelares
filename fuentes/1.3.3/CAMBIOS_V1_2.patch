+++ V1_2/src/v12_bajo.asm	2026-11-12 01:52:33.473831175 +0100
@@ -0,0 +1,460 @@
+; HALCONES ESTELARES 1.2 - MOAI CON DANO, BOCA, DERRUMBE Y LUNA (memoria baja).
+; Todo esto corre solo durante el MOAI, la escena mas ligera del juego.
+
+; Al empezar el MOAI.
+boss_v12_start:
+ xor a
+ ld (boss_blocks),a
+ ld (mouth_ticks),a
+ ld (moon_x),a
+ ld (moon_clock),a
+ ret
+
+; B = x, C = y: borra ese pixel en pantalla, imagen de trabajo y cielo.
+boss_pixel_clear:
+ ld l,c
+ ld h,0
+ add hl,hl
+ ld de,scanline_table
+ add hl,de
+ ld e,(hl)
+ inc hl
+ ld d,(hl)
+ ld a,b
+ rrca
+ rrca
+ rrca
+ and 31
+ add a,e
+ ld e,a
+ ld a,b
+ and 7
+ ld l,a
+ ld h,0
+ push de
+ ld de,bitmask_table
+ add hl,de
+ ld a,(hl)
+ cpl
+ ld c,a
+ pop hl
+ and (hl)
+ ld (hl),a                 ; pantalla
+ ld a,h
+ add a,0x80
+ ld h,a
+ ld a,c
+ and (hl)
+ ld (hl),a                 ; trabajo C000
+ ld a,h
+ add a,0x18
+ ld h,a
+ ld a,c
+ and (hl)
+ ld (hl),a                 ; cielo D800
+ ret
+
+; A = vida que le queda al MOAI: grietas nuevas al bajar a 12, 6 y 3.
+boss_damage_check:
+ ld b,0
+ cp 12
+ jr z,boss_crack
+ inc b
+ cp 6
+ jr z,boss_crack
+ inc b
+ cp 3
+ ret nz
+; B = etapa 0..2: grieta de 2 px de ancho que baja serpenteando.
+boss_crack:
+ ld a,b
+ add a,a
+ add a,b
+ ld e,a
+ ld d,0
+ ld hl,crack_starts
+ add hl,de
+ ld a,(hl)
+ ld (crack_x),a
+ inc hl
+ ld a,(hl)
+ ld (crack_y),a
+ inc hl
+ ld a,(hl)
+ ld (crack_len),a
+ ld a,(frame_index)
+ ld (crack_seed),a
+bc_loop:
+ ld a,(crack_x)
+ ld b,a
+ ld a,(crack_y)
+ ld c,a
+ call boss_pixel_clear
+ ld a,(crack_x)
+ inc a
+ ld b,a
+ ld a,(crack_y)
+ ld c,a
+ call boss_pixel_clear
+ ld a,(crack_seed)
+ ld b,a
+ add a,a
+ add a,a
+ add a,b
+ add a,17
+ ld (crack_seed),a
+ rlca
+ rlca
+ and 3                     ; 0 izquierda, 1-2 recto, 3 derecha
+ ld hl,crack_x
+ or a
+ jr nz,bc_right
+ dec (hl)
+ jr bc_down
+bc_right:
+ cp 3
+ jr nz,bc_down
+ inc (hl)
+bc_down:
+ ld hl,crack_y
+ inc (hl)
+ ld hl,crack_len
+ dec (hl)
+ jr nz,bc_loop
+ ret
+crack_starts: db 98,9,24, 84,38,30, 106,44,34
+
+; El MOAI dispara: la boca se abre (franja negra) unos ticks.
+mouth_open:
+ ld a,8
+ ld (mouth_ticks),a
+ xor a
+ jr mouth_set
+mouth_close:
+ ld a,1
+mouth_set:
+ ld (mouth_mode),a
+ ld c,65
+ms_row:
+ push bc
+ ld l,c
+ ld h,0
+ add hl,hl
+ ld de,scanline_table
+ add hl,de
+ ld e,(hl)
+ inc hl
+ ld d,(hl)
+ ld a,e
+ add a,11
+ ld e,a                    ; DE = pantalla (x=88)
+ ld b,2
+ms_col:
+ ld a,(mouth_mode)
+ or a
+ jr z,ms_put               ; abrir: 0
+ ld a,d
+ add a,0x98
+ ld h,a
+ ld l,e
+ ld a,(hl)                 ; cerrar: lo que hay en el cielo
+ms_put:
+ ld (de),a
+ ld l,a
+ ld a,d
+ add a,0x80
+ ld h,a
+ ld a,l
+ ld l,e
+ ld (hl),a                 ; misma copia en la imagen de trabajo
+ inc e
+ djnz ms_col
+ pop bc
+ inc c
+ ld a,c
+ cp 68
+ jr nz,ms_row
+ ret
+
+; Cada tick con el MOAI vivo: boca y luna.
+boss_alive_tick:
+ ld a,(mouth_ticks)
+ or a
+ jr z,moon_tick
+ dec a
+ ld (mouth_ticks),a
+ call z,mouth_close
+; La luna cruza por delante de Jupiter, 1 px cada 8 ticks.
+moon_tick:
+ ld a,(moon_clock)
+ inc a
+ and 7
+ ld (moon_clock),a
+ ret nz
+ call moon_erase
+ ld a,(moon_x)
+ or a
+ jr nz,moon_next
+ ld a,23                   ; primera vez: entra por la izquierda (x=24)
+moon_next:
+ inc a
+ cp 184
+ jr c,moon_store
+ ld a,24
+moon_store:
+ ld (moon_x),a
+ call moon_draw
+ jp moon_sync
+
+; Quita la luna del cielo y repone esas filas de Jupiter.
+moon_erase:
+ ld a,(moon_x)
+ or a
+ ret z
+ ld c,moon_y
+me_row:
+ push bc
+ call moon_row_addr        ; HL = cielo (D800) en la columna de la luna
+ xor a
+ ld (hl),a
+ inc hl
+ ld (hl),a
+ ; fila de Jupiter (7 bytes en x=128) desde los datos del planeta
+ ld a,c
+ sub 96
+ ld l,a
+ ld h,0
+ ld d,h
+ ld e,l
+ add hl,hl
+ add hl,hl
+ add hl,hl
+ or a
+ sbc hl,de                 ; (y-96)*7
+ ld de,0xf611
+ add hl,de
+ push hl
+ ld l,c
+ ld h,0
+ add hl,hl
+ ld de,scanline_table
+ add hl,de
+ ld e,(hl)
+ inc hl
+ ld d,(hl)
+ ld a,e
+ add a,16
+ ld e,a
+ ld a,d
+ add a,0x98
+ ld d,a
+ pop hl
+ ld bc,7
+ ldir
+ pop bc
+ inc c
+ ld a,c
+ cp moon_y+7
+ jr nz,me_row
+ ret
+
+; C = y -> HL = byte del cielo (D800) donde empieza la luna.
+moon_row_addr:
+ ld l,c
+ ld h,0
+ add hl,hl
+ ld de,scanline_table
+ add hl,de
+ ld e,(hl)
+ inc hl
+ ld d,(hl)
+ ld a,(moon_x)
+ rrca
+ rrca
+ rrca
+ and 31
+ add a,e
+ ld l,a
+ ld a,d
+ add a,0x98
+ ld h,a
+ ret
+
+; Dibuja la luna (disco de 7 px con crateres) tapando lo que haya detras.
+moon_draw:
+ ld c,moon_y
+ ld ix,moon_art
+md_row:
+ push bc
+ call moon_row_addr
+ ld d,(ix+0)               ; disco (mascara)
+ ld e,0
+ ld b,(ix+7)               ; dibujo
+ ld c,0
+ ld a,(moon_x)
+ and 7
+ jr z,md_shifted
+md_shift:
+ push af
+ ld a,d
+ or a
+ rra
+ ld d,a
+ ld a,e
+ rra
+ ld e,a
+ ld a,b
+ or a
+ rra
+ ld b,a
+ ld a,c
+ rra
+ ld c,a
+ pop af
+ dec a
+ jr nz,md_shift
+md_shifted:
+ ld a,d
+ cpl
+ and (hl)
+ or b
+ ld (hl),a
+ inc hl
+ ld a,e
+ cpl
+ and (hl)
+ or c
+ ld (hl),a
+ inc ix
+ pop bc
+ inc c
+ ld a,c
+ cp moon_y+7
+ jr nz,md_row
+ ret
+moon_art:
+ db 0x38,0x7c,0xfe,0xfe,0xfe,0x7c,0x38   ; disco
+ db 0x38,0x5c,0xee,0xfa,0xbe,0x74,0x38   ; luna con crateres
+
+; Lleva las 7 filas de la luna del cielo a la imagen de trabajo y a la pantalla
+; (columnas 2..23). Los sprites que pasen por ahi se repintan en el tick siguiente.
+moon_sync:
+ ld c,moon_y
+msy_row:
+ push bc
+ ld l,c
+ ld h,0
+ add hl,hl
+ ld de,scanline_table
+ add hl,de
+ ld e,(hl)
+ inc hl
+ ld d,(hl)
+ inc e
+ inc e                     ; columna 2
+ ld h,d
+ ld l,e
+ ld a,h
+ add a,0x98
+ ld h,a                    ; HL = cielo
+ push de
+ push hl
+ ld a,d
+ add a,0x80
+ ld d,a                    ; DE = trabajo
+ ld bc,22
+ ldir
+ pop hl
+ pop de                    ; DE = pantalla
+ ld bc,22
+ ldir
+ pop bc
+ inc c
+ ld a,c
+ cp moon_y+7
+ jr nz,msy_row
+ ret
+
+; Derrumbe del MOAI: 3 bloques de 8x8 por tick en orden salteado (66 bloques).
+; Devuelve Z cuando ha terminado.
+boss_blocks_tick:
+ ld a,(boss_blocks)
+ or a
+ jr nz,bbt_go
+ ld a,66
+ ld (boss_blocks),a
+ xor a
+ ld (boss_bidx),a
+ call moon_erase           ; la luna se va con el MOAI
+ xor a
+ ld (moon_x),a
+bbt_go:
+ call sfx_explode
+ ld b,3
+bbt_loop:
+ push bc
+ call boss_block_erase
+ pop bc
+ ld a,(boss_blocks)
+ dec a
+ ld (boss_blocks),a
+ ret z
+ djnz bbt_loop
+ or 1                      ; NZ: quedan bloques
+ ret
+
+boss_block_erase:
+ ld a,(boss_bidx)
+ ld c,0
+bbe_div:
+ cp 6
+ jr c,bbe_ok
+ sub 6
+ inc c
+ jr bbe_div
+bbe_ok:
+ add a,9
+ ld (blk_col),a
+ ld a,c
+ add a,a
+ add a,a
+ add a,a
+ add a,8
+ ld c,a                    ; primera linea del bloque
+ ld b,8
+bbe_row:
+ push bc
+ ld l,c
+ ld h,0
+ add hl,hl
+ ld de,scanline_table
+ add hl,de
+ ld e,(hl)
+ inc hl
+ ld d,(hl)
+ ld a,(blk_col)
+ add a,e
+ ld e,a
+ xor a
+ ld (de),a                 ; pantalla
+ ld a,d
+ add a,0x80
+ ld d,a
+ xor a
+ ld (de),a                 ; trabajo
+ ld a,d
+ add a,0x18
+ ld d,a
+ xor a
+ ld (de),a                 ; cielo
+ pop bc
+ inc c
+ djnz bbe_row
+ ld a,(boss_bidx)
+ add a,37
+ cp 66
+ jr c,bbe_store
+ sub 66
+bbe_store:
+ ld (boss_bidx),a
+ ret
diff -ruN '--exclude=__pycache__' '--exclude=build' '--exclude=*.tap' '--exclude=*.patch' '--exclude=*.md' '--exclude=*.txt' '--exclude=*.png' HALCONES_ESTELARES_CODIGO_FUENTE_1_1/src/v12_extras.asm hal/src/v12_extras.asm
--- V1_1/src/v12_extras.asm	1970-01-01 01:00:00.000000000 +0100
+++ V1_2/src/v12_extras.asm	2026-11-12 01:46:39.201807954 +0100
@@ -0,0 +1,16 @@
+; HALCONES ESTELARES 1.2 - datos del bloque de extras ($F401..$FDF9), tras el
+; MOAI, Jupiter y el GAME OVER. Solo datos (lo ensambla build.py aparte).
+; Semiperiodos (iteraciones de 26 T): C4 D4 Eb4 E4 F4 G4 Ab4 A4 Bb4 C5 D5 Eb5 E5 F5 G5 Ab5 Bb5 C6
+note_hp: dw 253,225,212,200,189,168,158,149,141,125,111,104,98,93,82,77,68,60
+; notas: 1 C4 2 D4 3 Eb4 4 E4 5 F4 6 G4 7 Ab4 8 A4 9 Bb4 10 C5 11 D5 12 Eb5
+;        13 E5 14 F5 15 G5 16 Ab5 17 Bb5 18 C6
+tune_title:
+ db 6,8, 10,8, 11,8, 12,16, 11,8, 10,8, 6,16, 7,8, 9,8, 10,16, 9,8, 7,8, 6,24, 0,8
+ db 6,8, 10,8, 11,8, 12,16, 14,8, 15,16, 14,8, 12,8, 11,16, 9,8, 10,32, 0,24
+ db 255
+tune_victory:
+ db 10,6, 13,6, 15,6, 18,18, 15,6, 18,30, 0,10, 255
+tune_gameover:
+ db 6,16, 5,16, 3,16, 2,16, 1,48, 255
+tune_record:
+ db 10,8, 13,8, 15,8, 18,8, 15,8, 18,24, 0,8, 15,6, 18,30, 255
diff -ruN '--exclude=__pycache__' '--exclude=build' '--exclude=*.tap' '--exclude=*.patch' '--exclude=*.md' '--exclude=*.txt' '--exclude=*.png' HALCONES_ESTELARES_CODIGO_FUENTE_1_1/src/v12_hud.asm hal/src/v12_hud.asm
--- V1_1/src/v12_hud.asm	1970-01-01 01:00:00.000000000 +0100
+++ V1_2/src/v12_hud.asm	2026-11-12 01:51:16.895303289 +0100
@@ -0,0 +1,474 @@
+; HALCONES ESTELARES 1.2 - MARCADOR NUEVO (parte que cambia).
+; La parte fija (bandas, raíles, logo ESF) se descomprime en hud_install.
+; Todo se dibuja en la pantalla real (columnas 25..30), fuera del compositor.
+hud_buf equ 0xf030          ; bytes de trabajo para componer cifras
+hp_addr equ 0xf040          ; direccion de pantalla en curso (2 bytes)
+hp_stride equ 0xf042        ; avance del origen por fila (bytes)
+shield_state_shown equ 0xf043
+record_words equ 0xf046     ; record de la sesion (impactos, como score_words)
+hud_tmp equ 0xf048
+face_k equ 0xf049
+; V1.2: MOAI y luna (rutinas en src/v12_bajo.asm)
+boss_blocks equ 0xf0a0      ; bloques del MOAI que quedan por derrumbar (0 = sin empezar)
+boss_bidx equ 0xf0a1        ; bloque siguiente (0..65), avanza de 37 en 37
+mouth_ticks equ 0xf0a2      ; ticks que la boca sigue abierta
+crack_seed equ 0xf0a3
+crack_x equ 0xf0a4
+crack_y equ 0xf0a5
+crack_len equ 0xf0a6
+mouth_mode equ 0xf0a7
+moon_x equ 0xf0a8           ; x de la luna (0 = aun no dibujada)
+moon_clock equ 0xf0a9
+blk_col equ 0xf0aa
+moon_y equ 113
+
+; hud_put: copia B filas de 1 byte a la columna C desde la linea A.
+; HL = origen; avanza hp_stride por fila. Destruye AF, B, DE, HL.
+hud_put:
+ push hl
+ ld l,a
+ ld h,0
+ add hl,hl
+ ld de,scanline_table
+ add hl,de
+ ex de,hl
+ pop hl
+hud_put_row:
+ ld a,(de)
+ add a,c
+ ld (hp_addr),a
+ inc de
+ ld a,(de)
+ ld (hp_addr+1),a
+ inc de
+ push de
+ ld de,(hp_addr)
+ ld a,(hl)
+ ld (de),a
+ ld a,(hp_stride)
+ ld e,a
+ ld d,0
+ add hl,de
+ pop de
+ djnz hud_put_row
+ ret
+
+; Todo el marcador (al empezar la partida y tras la pantalla de fase).
+hud_draw_all:
+ ld a,255
+ ld (lives_displayed),a
+ ld (shield_meter_displayed),a
+ ld (shield_state_shown),a
+ call score_draw
+ call lives_hud_present
+ call shield_bar_present
+ jp hud_phase_draw
+
+; PUNTOS: "0" + 4 cifras de score_words + "0" en cifras gruesas 7x8.
+score_draw:
+ call score_to_digits
+ ld hl,score_digits
+ ld de,hud_buf+1
+ ld bc,4
+ ldir
+ xor a
+ ld (hud_buf),a
+ ld (hud_buf+5),a
+ ld a,1
+ ld (hp_stride),a
+ ld c,25
+ ld hl,hud_buf
+score_big_loop:
+ push hl
+ ld l,(hl)
+ ld h,0
+ add hl,hl
+ add hl,hl
+ add hl,hl
+ ld de,hud_big_digits
+ add hl,de
+ ld b,8
+ ld a,12
+ call hud_put
+ pop hl
+ inc hl
+ inc c
+ ld a,c
+ cp 31
+ jr nz,score_big_loop
+ ; RECORD: si los puntos lo superan, se actualiza en vivo.
+ ld hl,(score_words)
+ ld de,(record_words)
+ or a
+ sbc hl,de
+ jr c,record_draw
+ ld hl,(score_words)
+ ld (record_words),hl
+; RECORD en cifras de 3x5, dos por byte, columnas 28..30.
+record_draw:
+ call record_digits
+ ld c,28
+ ld hl,hud_buf
+record_pair_loop:
+ ld a,(hl)
+ inc hl
+ ld b,(hl)
+ inc hl
+ push hl
+ push bc
+ call nibble_pair
+ pop bc
+ ld a,1
+ ld (hp_stride),a
+ ld hl,hud_buf+8
+ ld b,5
+ ld a,26
+ call hud_put
+ pop hl
+ inc c
+ ld a,c
+ cp 31
+ jr nz,record_pair_loop
+ ret
+
+; A = cifra izquierda, B = cifra derecha -> 5 filas en hud_buf+8..+12.
+nibble_pair:
+ push bc
+ call nibble_addr
+ ld de,hud_buf+8
+ ld b,5
+nibble_left:
+ ld a,(hl)
+ rlca
+ rlca
+ rlca
+ rlca
+ ld (de),a
+ inc hl
+ inc de
+ djnz nibble_left
+ pop bc
+ ld a,b
+ call nibble_addr
+ ld de,hud_buf+8
+ ld b,5
+nibble_right:
+ ld a,(de)
+ or (hl)
+ ld (de),a
+ inc hl
+ inc de
+ djnz nibble_right
+ ret
+nibble_addr:                    ; HL = hud_nibble_digits + A*5
+ ld l,a
+ ld h,0
+ ld d,h
+ ld e,l
+ add hl,hl
+ add hl,hl
+ add hl,de
+ ld de,hud_nibble_digits
+ add hl,de
+ ret
+
+; ESCUDO: 8 segmentos; LISTO (verde parpadeante), ACTIVO (cian) o CARGANDO
+; (amarillo) con la barra en rojo-amarillo-verde mientras se recarga.
+shield_bar_present:
+ ld a,(shield_meter)
+ ld b,a
+ ld a,(shield_state)
+ ld c,a
+ ld a,(shield_meter_displayed)
+ cp b
+ jr nz,shield_bar_redraw
+ ld a,(shield_state_shown)
+ cp c
+ ret z
+shield_bar_redraw:
+ ld a,b
+ ld (shield_meter_displayed),a
+ ld a,c
+ ld (shield_state_shown),a
+ ld l,b
+ ld h,0
+ ld d,h
+ ld e,l
+ add hl,hl
+ add hl,de
+ add hl,hl
+ ld de,hud_shield_rows
+ add hl,de
+ xor a
+ ld (hp_stride),a
+ ld c,25
+shield_bar_col:
+ push hl
+ ld b,4
+ ld a,74
+ call hud_put
+ pop hl
+ inc hl
+ inc c
+ ld a,c
+ cp 31
+ jr nz,shield_bar_col
+ ld a,(shield_state)
+ ld hl,hud_txt_listo
+ ld b,0xc4
+ ld de,shield_colors_ready
+ or a
+ jr z,shield_text
+ ld hl,hud_txt_activo
+ ld b,0x45
+ ld de,shield_colors_active
+ cp 1
+ jr z,shield_text
+ ld hl,hud_txt_carga
+ ld b,0x06
+ ld de,shield_colors_charge
+shield_text:
+ ld a,b
+ ld (hud_tmp),a
+ push de
+ ld a,6
+ ld (hp_stride),a
+ ld c,25
+shield_text_col:
+ push hl
+ ld b,5
+ ld a,82
+ call hud_put
+ pop hl
+ inc hl
+ inc c
+ ld a,c
+ cp 31
+ jr nz,shield_text_col
+ ld hl,0x5800+10*32+25
+ ld a,(hud_tmp)
+ ld b,6
+shield_text_attr:
+ ld (hl),a
+ inc hl
+ djnz shield_text_attr
+ pop hl
+ ld de,0x5800+9*32+25
+ ld bc,6
+ ldir
+; La sombra privada de atributos sigue siendo copia exacta de la pantalla
+; tambien en el marcador (columnas 24..31), aunque el compositor no lo toque.
+hud_attr_sync:
+ ld hl,0x5800+24
+ ld de,0xf100+24
+ ld a,24
+has_row:
+ ld bc,8
+ ldir
+ ld bc,24
+ add hl,bc
+ ex de,hl
+ add hl,bc
+ ex de,hl
+ dec a
+ jr nz,has_row
+ ret
+shield_colors_ready: db 0x44,0x44,0x44,0x44,0x44,0x44
+shield_colors_active: db 0x45,0x45,0x45,0x45,0x45,0x45
+shield_colors_charge: db 0x42,0x42,0x46,0x46,0x44,0x44
+
+; hud_buf[0..5] = cifras del record: 0, millares, centenas, decenas, unidades, 0.
+record_digits:
+ ld hl,(score_words)
+ push hl
+ ld hl,(record_words)
+ ld (score_words),hl
+ call score_to_digits
+ pop hl
+ ld (score_words),hl
+ ld hl,score_digits
+ ld de,hud_buf+1
+ ld bc,4
+ ldir
+ xor a
+ ld (hud_buf),a
+ ld (hud_buf+5),a
+ ret
+
+; A = linea, C = primera columna: 6 cifras de hud_buf con la fuente de 5x7.
+digits6_draw:
+ ld hl,hud_buf
+ ld b,6
+; A = linea, C = columna, B = numero de cifras, HL = cifras.
+digits_n_draw:
+ ld (hud_tmp),a
+digits6_loop:
+ push bc
+ push hl
+ ld l,(hl)
+ ld h,0
+ ld d,h
+ ld e,l
+ add hl,hl
+ add hl,hl
+ add hl,hl
+ or a
+ sbc hl,de                  ; cifra*7
+ ld de,digit_bitmaps
+ add hl,de
+ ld a,1
+ ld (hp_stride),a
+ ld b,7
+ ld a,(hud_tmp)
+ call hud_put
+ pop hl
+ inc hl
+ pop bc
+ inc c
+ djnz digits6_loop
+ ret
+
+new_record equ 0xf04e
+record_start equ 0xf062
+; hud_buf[0..5] = cifras de los puntos (0, 4 cifras, 0).
+score_digits6:
+ call score_to_digits
+ ld hl,score_digits
+ ld de,hud_buf+1
+ ld bc,4
+ ldir
+ xor a
+ ld (hud_buf),a
+ ld (hud_buf+5),a
+ ret
+
+; VIDAS: tres caras; con la ultima vida la que queda pone cara apurada; las
+; perdidas son un circulo azul punteado.
+lives_hud_present:
+ ld a,(player_lives)
+ ld b,a
+ ld a,(lives_displayed)
+ cp b
+ ret z
+ ld a,b
+ ld (lives_displayed),a
+ xor a
+ ld (face_k),a
+lives_face_loop:
+ ld a,(face_k)
+ ld b,a
+ ld a,(player_lives)
+ ld hl,hud_face_vacia
+ ld c,0x01
+ cp b
+ jr z,lives_face_ready
+ jr c,lives_face_ready
+ ld c,0x46
+ ld hl,hud_face_feliz
+ cp 1
+ jr nz,lives_face_ready
+ ld hl,hud_face_apurado
+lives_face_ready:
+ ld a,c
+ ld (hud_tmp),a
+ ld a,2
+ ld (hp_stride),a
+ ld a,(face_k)
+ add a,a
+ add a,25
+ ld c,a
+ push hl
+ ld b,13
+ ld a,42
+ call hud_put
+ pop hl
+ inc hl
+ inc c
+ ld b,13
+ ld a,42
+ call hud_put
+ ld a,(face_k)
+ add a,a
+ add a,25
+ ld l,a
+ ld h,0
+ ld de,0x5800+5*32
+ add hl,de
+ ld a,(hud_tmp)
+ ld (hl),a
+ inc hl
+ ld (hl),a
+ ld de,31
+ add hl,de
+ ld (hl),a
+ inc hl
+ ld (hl),a
+ ld a,(face_k)
+ inc a
+ ld (face_k),a
+ cp 3
+ jr nz,lives_face_loop
+ jp hud_attr_sync
+
+
+
+; V1.2: genera en $5B00..$5F7F las 8 fases desplazadas de los 3 tiempos de la
+; explosion (16x16 -> 3 bytes x 16 filas). La memoria de $5B00 (buffer de
+; impresora y variables del BASIC) no se usa una vez arrancado el juego.
+explosion_shift_init:
+ ld hl,explosion_src
+ ld de,0x5b00
+ ld c,3
+esi_frame:
+ push bc
+ ld b,16
+esi_phase0:
+ ld a,(hl)
+ ld (de),a
+ inc hl
+ inc de
+ ld a,(hl)
+ ld (de),a
+ inc hl
+ inc de
+ xor a
+ ld (de),a
+ inc de
+ djnz esi_phase0
+ ld c,7
+esi_phase:
+ push hl
+ ld a,e
+ sub 48
+ ld l,a
+ ld a,d
+ jr nc,esi_prev
+ dec a
+esi_prev:
+ ld h,a                     ; HL = fase anterior (DE-48)
+ ld b,16
+esi_row:
+ or a
+ ld a,(hl)
+ rra
+ ld (de),a
+ inc hl
+ inc de
+ ld a,(hl)
+ rra
+ ld (de),a
+ inc hl
+ inc de
+ ld a,(hl)
+ rra
+ ld (de),a
+ inc hl
+ inc de
+ djnz esi_row
+ pop hl
+ dec c
+ jr nz,esi_phase
+ pop bc
+ dec c
+ jr nz,esi_frame
+ ret
diff -ruN '--exclude=__pycache__' '--exclude=build' '--exclude=*.tap' '--exclude=*.patch' '--exclude=*.md' '--exclude=*.txt' '--exclude=*.png' HALCONES_ESTELARES_CODIGO_FUENTE_1_1/src/v12_sound.asm hal/src/v12_sound.asm
--- V1_1/src/v12_sound.asm	1970-01-01 01:00:00.000000000 +0100
+++ V1_2/src/v12_sound.asm	2026-11-12 01:46:39.199112557 +0100
@@ -0,0 +1,313 @@
+; HALCONES ESTELARES 1.2 - SONIDO.
+; El beeper lo mueve la CPU: aqui solo se toca en el tiempo que sobra. Durante
+; la partida, tick_wait toca el efecto en curso mientras espera la interrupcion
+; (el juego no pierde ni un fotograma); en titulo, fase superada y GAME OVER
+; music_frame toca la melodia hasta cada interrupcion.
+; Efecto: db prioridad; segmentos dw semiperiodo, db delta (con signo, por tick),
+; db ticks, db modo (0 tono, 1 ruido, 2 silencio); fin = dw 0.
+snd_ear equ 0xf050
+snd_seg equ 0xf051          ; puntero al siguiente segmento (0 = sin efecto)
+snd_hp equ 0xf053           ; semiperiodo en curso (iteraciones de 26 T)
+snd_delta equ 0xf055
+snd_left equ 0xf056
+snd_mode equ 0xf057
+snd_prio equ 0xf058
+snd_rng equ 0xf059
+mus_ptr equ 0xf05a
+mus_left equ 0xf05c
+mus_note equ 0xf05d
+mus_loop equ 0xf05e
+snd_play_mode equ 0xf060
+
+; HL = efecto. Solo suena si su prioridad es >= la del efecto en curso.
+sfx_start:
+ ld a,(snd_left)
+ or a
+ jr z,sfx_take
+ ld a,(snd_prio)
+ cp (hl)
+ jr z,sfx_take
+ ret nc
+sfx_take:
+ ld a,(hl)
+ ld (snd_prio),a
+ inc hl
+; HL = segmento a cargar.
+sfx_load:
+ ld a,(hl)
+ inc hl
+ ld e,a
+ ld a,(hl)
+ inc hl
+ ld d,a
+ or e
+ jr z,sfx_end
+ ld (snd_hp),de
+ ld a,(hl)
+ inc hl
+ ld (snd_delta),a
+ ld a,(hl)
+ inc hl
+ ld (snd_left),a
+ ld a,(hl)
+ inc hl
+ ld (snd_mode),a
+ ld (snd_seg),hl
+ ret
+sfx_end:
+ xor a
+ ld (snd_left),a
+ ld (snd_prio),a
+ ret
+
+; Una vez por tick de juego: avanza el efecto (barrido y segmentos).
+snd_tick:
+ ld a,(snd_left)
+ or a
+ ret z
+ dec a
+ ld (snd_left),a
+ jr nz,snd_sweep
+ ld hl,(snd_seg)
+ jr sfx_load
+snd_sweep:
+ ld a,(snd_delta)
+ ld e,a
+ ld d,0
+ bit 7,a
+ jr z,snd_sweep_add
+ dec d
+snd_sweep_add:
+ ld hl,(snd_hp)
+ add hl,de
+ ld (snd_hp),hl
+ ret
+
+; Toca el efecto en curso hasta que tick_irqs deje de valer E (o espera).
+snd_slice:
+ ld a,(snd_left)
+ or a
+ jr z,snd_rest
+ ld a,(snd_mode)
+ cp 2
+ jr z,snd_rest
+ ld hl,(snd_hp)
+ ld (snd_play_mode),a
+ jr tone_half
+; A = modo (0 tono, 1 ruido), HL = semiperiodo: suena hasta la siguiente IRQ.
+tone_until_irq:
+ ld (snd_play_mode),a
+ ld a,(tick_irqs)
+ ld e,a
+tone_half:
+ ld a,(snd_play_mode)
+ or a
+ jr z,tone_square
+ ld a,(snd_rng)
+ add a,a
+ jr nc,tone_noise_ok
+ xor 0x1d
+tone_noise_ok:
+ ld (snd_rng),a
+ and 16
+ jr tone_out
+tone_square:
+ ld a,(snd_ear)
+ xor 16
+tone_out:
+ ld (snd_ear),a
+ out (0xfe),a
+ ld b,h
+ ld c,l
+tone_delay:
+ dec bc
+ ld a,b
+ or c
+ jr nz,tone_delay
+ ld a,(tick_irqs)
+ cp e
+ jr z,tone_half
+ ret
+snd_rest:
+ ld a,(tick_irqs)
+ cp e
+ ret nz
+ halt
+ ret
+
+; MUSICA: tune = pares (nota 1..18, fotogramas); nota 0 = silencio; 255 = fin.
+; HL = melodia, DE = punto de vuelta (0 = no se repite).
+music_start:
+ ld (mus_ptr),hl
+ ld (mus_loop),de
+ xor a
+ ld (mus_left),a
+ ret
+music_stop:
+ ld hl,0
+ ld (mus_ptr),hl
+ xor a
+ ld (mus_left),a
+ ret
+; Toca un fotograma de musica (hasta la siguiente IRQ).
+music_frame:
+ ld a,(tick_irqs)
+ ld e,a
+ ld a,(mus_left)
+ or a
+ jr nz,music_play
+ ld hl,(mus_ptr)
+ ld a,h
+ or l
+ jr z,music_rest
+ ld a,(hl)
+ cp 255
+ jr nz,music_note
+ ld hl,(mus_loop)
+ ld a,h
+ or l
+ jr z,music_end
+ ld a,(hl)
+music_note:
+ ld (mus_note),a
+ inc hl
+ ld a,(hl)
+ inc hl
+ ld (mus_left),a
+ ld (mus_ptr),hl
+music_play:
+ ld a,(mus_left)
+ dec a
+ ld (mus_left),a
+ ld a,(mus_note)
+ or a
+ jr z,music_rest
+ add a,a
+ ld l,a
+ ld h,0
+ ld de,note_hp-2
+ add hl,de
+ ld a,(hl)
+ inc hl
+ ld h,(hl)
+ ld l,a
+ xor a
+ jp tone_until_irq
+music_end:
+ call music_stop
+music_rest:
+ ld a,(tick_irqs)
+ ld e,a
+ jr snd_rest
+
+; Llamadas de efecto (sustituyen a los clics de la 1.1).
+sfx_shot:
+ ld hl,fx_shot
+ jp sfx_start
+sfx_enemy_fire:
+ ld hl,fx_enemy_fire
+ jp sfx_start
+sfx_boss_fire:
+ ld hl,fx_boss_fire
+ jp sfx_start
+sfx_explode:
+ ld hl,fx_explode
