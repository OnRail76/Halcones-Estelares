+ halt
+ ld bc,0xbffe
+ in a,(c)
+ and 16
+ jr z,pc_wait_release
+pc_wait_press:
+ halt
+ ld bc,0xbffe
+ in a,(c)
+ and 16
+ jr nz,pc_wait_press
+ xor a
+ out (0xfe),a
+ ld (game_paused),a
+ ld (tick_irqs),a
+ ret
+
+; ---------------------------------------------------------------------------
+; MARCADOR DE 16 BITS Y VIDA EXTRA
+; score_words cuenta impactos (puntos/10) hasta 9999 = 99.990 puntos.
+; Cada 100 impactos (1.000 puntos) se gana una vida, si quedan menos de 3.
+score_add_kill:
+ ld a,(kills)               ; Byte historico (sin uso para el marcador).
+ inc a
+ ld (kills),a
+ ld hl,(score_words)
+ ld de,9999
+ or a
+ sbc hl,de
+ jr nc,sak_counted
+ add hl,de
+ inc hl
+ ld (score_words),hl
+sak_counted:
+ ld a,(life_next)
+ inc a
+ cp 100
+ jr c,sak_store
+ ld a,(player_lives)
+ or a
+ jr z,sak_reset             ; Ya sin vidas: no se resucita en la explosion final.
+ cp 3
+ jr nc,sak_reset
