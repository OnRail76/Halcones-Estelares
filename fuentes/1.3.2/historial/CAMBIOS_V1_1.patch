@@ -0,0 +1,296 @@
+; HALCONES ESTELARES 1.1 - RUTINAS FRIAS EN MEMORIA BAJA ($7E20..$7FFF).
+; Se cargan junto a los sprites reubicados. Solo JP/CALL hacia el bloque
+; principal (las direcciones las inyecta build.py). Codigo poco frecuente:
+; arranque, titulo, pausa, marcador, cartel de oleada y tablas.
+
+
+; Kempston solo si 256 lecturas seguidas tienen los bits 5..7 a cero y nunca
+; izquierda+derecha a la vez (sin interfaz el bus flotante da $FF).
+kempston_detect:
+ xor a
+ ld (kempston_ok),a
+ ld (kempston_mode),a
+ halt
+ ld b,0
+kd_loop:
+ in a,(0x1f)
+ ld c,a
+ and 0xe0
+ ret nz
+ ld a,c
+ and 3
+ cp 3
+ ret z
+ djnz kd_loop
+ ld a,1
+ ld (kempston_ok),a
+ ret
+
+; Z = algun fuego pulsado (SPACE, 0 de Sinclair o Kempston si existe).
+; Usado en titulo y GAME OVER. Destruye AF, BC.
+any_fire_pressed:
+ ld bc,0x7ffe
+ in a,(c)
+ and 1
+ ret z
+ ld b,0xef
+ in a,(c)
+ and 1
+ ret z
+ ld a,(kempston_ok)
+ or a
+ jr z,afp_none
+ in a,(0x1f)
+ and 0x10
+ jr z,afp_none
+ xor a
+ ret
+afp_none:
+ or 1
+ ret
+
+; Al empezar: se juega con Kempston solo si se pulso SU fuego en el titulo.
+title_choose_controls:
+ xor a
+ ld (kempston_mode),a
+ ld a,(kempston_ok)
+ or a
+ ret z
+ in a,(0x1f)
+ and 0x10
+ ret z
+ ld a,1
+ ld (kempston_mode),a
+ ret
+
+; H = pausa. Borde azul; el IM2 deja quietos escudo, invulnerabilidad y
+; reagrupamientos. Otra pulsacion de H continua.
+pause_check:
+ ld bc,0xbffe
+ in a,(c)
+ and 16
+ jr z,pc_down
+ xor a
+ ld (pause_held),a
+ ret
+pc_down:
+ ld a,(pause_held)
+ or a
+ ret nz
+ ld a,1
+ ld (pause_held),a
+ ld (game_paused),a
+ ld a,1
+ out (0xfe),a
