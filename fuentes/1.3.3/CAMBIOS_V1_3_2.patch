+    def po(port,v):
+        if port&1==0:outs.append(s.frames)
+        op(port,v)
+    z.port_out=po
+    for f in range(50*25):s.frame(())
+    z.port_out=op
+    per=[0]*25
+    for x in outs:per[(x-start)//50]+=1
+    return per
